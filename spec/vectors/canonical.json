{
  "profile": "RFC 8949 core deterministic; floats запрещены; NFC до кодирования",
  "spec": "spec/canonical-record-v1.md",
  "vectors": [
    {
      "description": "нижняя граница короткой формы",
      "expected": {
        "byte_len": 1,
        "cbor_hex": "00"
      },
      "id": "int-zero",
      "input": {
        "type": "int",
        "value": "0"
      }
    },
    {
      "description": "последнее значение в заголовке",
      "expected": {
        "byte_len": 1,
        "cbor_hex": "17"
      },
      "id": "int-23",
      "input": {
        "type": "int",
        "value": "23"
      }
    },
    {
      "description": "переход на 1-байтовый argument",
      "expected": {
        "byte_len": 2,
        "cbor_hex": "1818"
      },
      "id": "int-24",
      "input": {
        "type": "int",
        "value": "24"
      }
    },
    {
      "description": "граница 1 байта",
      "expected": {
        "byte_len": 2,
        "cbor_hex": "18ff"
      },
      "id": "int-255",
      "input": {
        "type": "int",
        "value": "255"
      }
    },
    {
      "description": "переход на 2 байта",
      "expected": {
        "byte_len": 3,
        "cbor_hex": "190100"
      },
      "id": "int-256",
      "input": {
        "type": "int",
        "value": "256"
      }
    },
    {
      "description": "переход на 4 байта",
      "expected": {
        "byte_len": 5,
        "cbor_hex": "1a00010000"
      },
      "id": "int-65536",
      "input": {
        "type": "int",
        "value": "65536"
      }
    },
    {
      "description": "переход на 8 байт",
      "expected": {
        "byte_len": 9,
        "cbor_hex": "1b0000000100000000"
      },
      "id": "int-4294967296",
      "input": {
        "type": "int",
        "value": "4294967296"
      }
    },
    {
      "description": "major type 1, кратчайшая форма",
