        "byte_len": 3,
        "cbor_hex": "622d30"
      },
      "id": "decimal-negative-zero",
      "input": {
        "type": "text",
        "value": "-0"
      }
    },
    {
      "description": "UTC без дробной части",
      "expected": {
        "byte_len": 21,
        "cbor_hex": "74323032362d30372d33315430303a30303a30305a"
      },
      "id": "timestamp-rfc3339",
      "input": {
        "type": "text",
        "value": "2026-07-31T00:00:00Z"
      }
    },
    {
      "description": "60-я секунда допустима в RFC 3339 и должна кодироваться как есть",
      "expected": {
        "byte_len": 21,
        "cbor_hex": "74323031362d31322d33315432333a35393a36305a"
      },
      "id": "timestamp-leap-second",
      "input": {
        "type": "text",
        "value": "2016-12-31T23:59:60Z"
      }
    },
    {
      "description": "пустой массив",
      "expected": {
        "byte_len": 1,
        "cbor_hex": "80"
      },
      "id": "array-empty",
      "input": {
        "items": [],
        "type": "array"
      }
    },
    {
      "description": "порядок массива значим",
