        "byte_len": 1,
        "cbor_hex": "20"
      },
      "id": "int-neg-1",
      "input": {
        "type": "int",
        "value": "-1"
      }
    },
    {
      "description": "последнее значение в заголовке",
      "expected": {
        "byte_len": 1,
        "cbor_hex": "37"
      },
      "id": "int-neg-24",
      "input": {
        "type": "int",
        "value": "-24"
      }
    },
    {
      "description": "переход на 1-байтовый argument",
      "expected": {
        "byte_len": 2,
        "cbor_hex": "3818"
      },
      "id": "int-neg-25",
      "input": {
        "type": "int",
        "value": "-25"
      }
    },
    {
      "description": "null отличается от отсутствующего ключа",
      "expected": {
        "byte_len": 1,
        "cbor_hex": "f6"
      },
      "id": "null",
      "input": {
        "type": "null"
      }
    },
    {
      "description": "простое значение",
      "expected": {
        "byte_len": 1,
        "cbor_hex": "f5"
      },
      "id": "bool-true",
      "input": {
        "type": "bool",
        "value": true
      }
    },
    {
      "description": "простое значение",
      "expected": {
        "byte_len": 1,
        "cbor_hex": "f4"
      },
      "id": "bool-false",
      "input": {
        "type": "bool",
        "value": false
      }
    },
    {
      "description": "пустая строка",
      "expected": {
        "byte_len": 1,
        "cbor_hex": "60"
      },
      "id": "text-empty",
      "input": {
        "type": "text",
        "value": ""
      }
    },
    {
      "description": "U+0439 — NFC-форма",
      "expected": {
        "byte_len": 3,
        "cbor_hex": "62d0b9"
      },
      "id": "text-cyrillic-precomposed",
      "input": {
        "type": "text",
        "value": "й"
      }
    },
    {
      "description": "U+0438 U+0306 — обязан дать те же байты, что precomposed",
      "expected": {
        "byte_len": 3,
        "cbor_hex": "62d0b9"
      },
      "id": "text-cyrillic-decomposed",
      "input": {
        "type": "text",
        "value": "й"
      }
    },
    {
      "description": "U+0587 не разлагается под NFC (в отличие от NFKC)",
