        "byte_len": 5,
        "cbor_hex": "64302e3130"
      },
      "id": "decimal-scale-preserved",
      "input": {
        "type": "text",
        "value": "0.10"
      }
    },
    {
      "description": "парный вектор к decimal-scale-preserved",
