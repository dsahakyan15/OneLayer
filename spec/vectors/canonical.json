        "byte_len": 9,
        "cbor_hex": "682d313233342e3530"
      },
      "id": "decimal-negative",
      "input": {
        "type": "text",
        "value": "-1234.50"
      }
    },
    {
      "description": "-0 отличается от 0 как строка",
