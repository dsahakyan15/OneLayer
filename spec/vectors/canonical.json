    },
    {
      "description": "парный вектор к array-order-ab",
      "expected": {
        "byte_len": 5,
        "cbor_hex": "8261626161"
      },
      "id": "array-order-ba",
      "input": {
        "items": [
          {
            "type": "text",
            "value": "b"
          },
          {
            "type": "text",
            "value": "a"
          }
        ],
        "type": "array"
      }
    },
