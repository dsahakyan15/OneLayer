        "byte_len": 5,
        "cbor_hex": "64f09f9880"
      },
      "id": "text-non-bmp",
      "input": {
        "type": "text",
        "value": "😀"
      }
    },
    {
      "description": "U+200F значим и не удаляется",
      "expected": {
        "byte_len": 6,
        "cbor_hex": "6561e2808f62"
      },
      "id": "text-rtl-marker",
      "input": {
        "type": "text",
        "value": "a‏b"
      }
    },
    {
      "description": "0.10 и 0.1 различны: decimal — строка с фиксированным scale",
