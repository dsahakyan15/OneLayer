        "byte_len": 3,
        "cbor_hex": "62d687"
      },
      "id": "text-armenian-ligature",
      "input": {
        "type": "text",
        "value": "և"
      }
    },
    {
      "description": "U+1F600: суррогатная пара в UTF-16, 4 байта в UTF-8",
