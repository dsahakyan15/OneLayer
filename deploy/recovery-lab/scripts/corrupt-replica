#!/usr/bin/env bash
set -euo pipefail

project=onelayer-recovery-lab
container=${project}-custodian-a-1
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
lab_dir=$(cd -- "$script_dir/.." && pwd)
if [[ ${DESTROY_ONELAYER_FIXTURE:-} != yes ]]; then
  echo "DESTROY_ONELAYER_FIXTURE=yes is required" >&2
  exit 30
fi
"$script_dir/fixture-guard" container "$container"
object=${1:?explicit synthetic object name required}
if [[ ! "$object" =~ ^[0-9a-f]{32}\.cbor$ ]]; then
  echo "object path is outside the synthetic fixture bucket" >&2
  exit 31
fi
docker compose -p "$project" -f "$lab_dir/compose.yaml" --profile restore run --rm -e "SNAPSHOT_OBJECT=$object" corruptor-a
printf '%s\n' "$container:onelayer-fixture/$object"
