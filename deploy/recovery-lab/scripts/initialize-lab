#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)
secret_root=/dev/shm/onelayer-recovery-lab-secrets
if [[ -e "$secret_root" ]]; then
  echo "lab secret tmpfs already exists" >&2
  exit 60
fi
umask 077
mkdir -p "$secret_root"
head -c 32 /dev/urandom > "$secret_root/recovery-kek"
node "$repo_root/packages/snapshot-ts/src/cli.ts" split-kek "$secret_root/recovery-kek" "$secret_root/recovery-share-"
random_text() { od -An -N24 -tx1 /dev/urandom | tr -d ' \n'; }
random_text > "$secret_root/source-db-password"
random_text > "$secret_root/restore-db-password"
for custodian in a b c; do
  printf 'fixture-%s\n' "$custodian" > "$secret_root/custodian-${custodian}-user"
  random_text > "$secret_root/custodian-${custodian}-password"
done
echo "recovery lab tmpfs secrets initialized"
