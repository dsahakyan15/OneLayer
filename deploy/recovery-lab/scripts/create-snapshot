#!/usr/bin/env bash
set -euo pipefail

project=onelayer-recovery-lab
container=${project}-snapshot-coordinator-1
source_container=${project}-source-db-1
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
lab_dir=$(cd -- "$script_dir/.." && pwd)
snapshot_id=${1:?snapshot id hex required}
snapshot_version=${2:?snapshot version required}
if [[ ! "$snapshot_id" =~ ^[0-9a-f]{32}$ || ! "$snapshot_version" =~ ^[1-9][0-9]*$ ]]; then
  echo "snapshot identity is invalid" >&2
  exit 32
fi
"$script_dir/fixture-guard" container "$container"
"$script_dir/fixture-guard" container "$source_container"
docker exec "$container" sh -eu -c 'test -r /run/secrets/recovery_kek; test "$(wc -c < /run/secrets/recovery_kek)" -eq 32'
docker exec "$source_container" sh -eu -c 'PGPASSWORD=$(cat /run/secrets/source_db_password); export PGPASSWORD; test "$(psql -U onelayer_fixture -d onelayer_fixture -Atc "select marker from onelayer_fixture_marker")" = ONELAYER_SYNTHETIC_FIXTURE_V1'
dump_file=$(mktemp /tmp/onelayer-recovery-lab-dump.XXXXXX)
trap 'truncate -s 0 "$dump_file"; rm -f "$dump_file"' EXIT
docker exec "$source_container" sh -eu -c 'PGPASSWORD=$(cat /run/secrets/source_db_password); export PGPASSWORD; pg_dump -U onelayer_fixture -d onelayer_fixture --format=custom' > "$dump_file"
docker cp "$dump_file" "$container:/exchange/source.dump"
object="${snapshot_id}.cbor"
docker exec "$container" node packages/snapshot-ts/src/cli.ts create /exchange/source.dump "/exchange/$object" /run/secrets/recovery_kek gov.registry.land "$snapshot_id" "$snapshot_version" 1048576 lab-kek-v1
docker exec "$container" node packages/snapshot-ts/src/cli.ts verify "/exchange/$object"
for uploader in uploader-a uploader-b uploader-c; do
  docker compose -p "$project" -f "$lab_dir/compose.yaml" --profile snapshot run --rm -e "SNAPSHOT_OBJECT=$object" "$uploader"
done
docker exec "$container" sh -eu -c 'truncate -s 0 /exchange/source.dump; rm /exchange/source.dump'
docker compose -p "$project" -f "$lab_dir/compose.yaml" rm -sf snapshot-coordinator
secret_root=/dev/shm/onelayer-recovery-lab-secrets
if [[ -f "$secret_root/recovery-kek" ]]; then
  truncate -s 0 "$secret_root/recovery-kek"
  rm "$secret_root/recovery-kek"
fi
printf '%s\n' "$object"
