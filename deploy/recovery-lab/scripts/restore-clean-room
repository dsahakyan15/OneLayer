#!/usr/bin/env bash
set -euo pipefail

project=onelayer-recovery-lab
container=${project}-clean-room-restore-1
database=${project}-clean-room-db-1
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
lab_dir=$(cd -- "$script_dir/.." && pwd)
object=${1:?snapshot object name required}
if [[ ! "$object" =~ ^[0-9a-f]{32}\.cbor$ ]]; then
  echo "snapshot object name is invalid" >&2
  exit 41
fi
"$script_dir/fixture-guard" container "$container"
"$script_dir/fixture-guard" container "$database"
if docker inspect "${project}-source-db-1" >/dev/null 2>&1; then
  echo "source-db still exists; clean-room restore is not isolated from primary loss" >&2
  exit 42
fi
if docker inspect --format '{{json .NetworkSettings.Networks}}' "$container" | tr ',' '\n' | awk '/onelayer-recovery-lab_source/ { found=1 } END { exit found ? 0 : 1 }'; then
  echo "clean-room restore unexpectedly has source network access" >&2
  exit 40
fi
if docker compose -p "$project" -f "$lab_dir/compose.yaml" --profile restore run --rm -e "SNAPSHOT_OBJECT=$object" retriever-b \
   && docker exec "$container" node packages/snapshot-ts/src/cli.ts verify "/exchange/$object"; then
  :
else
  docker compose -p "$project" -f "$lab_dir/compose.yaml" --profile restore run --rm -e "SNAPSHOT_OBJECT=$object" retriever-c
  docker exec "$container" node packages/snapshot-ts/src/cli.ts verify "/exchange/$object"
fi
for index in 1 3 5; do
  holder="${project}-key-holder-${index}-1"
  "$script_dir/fixture-guard" container "$holder"
  docker exec "$holder" cat "/run/secrets/recovery_share_${index}" | docker exec -i "$container" sh -eu -c "umask 077; cat > /run/onelayer-recovery/share-${index}"
done
docker exec "$container" node packages/snapshot-ts/src/cli.ts restore "/exchange/$object" /work/source.dump /run/onelayer-recovery/share-1 /run/onelayer-recovery/share-3 /run/onelayer-recovery/share-5
docker exec "$container" cat /work/source.dump | docker exec -i "$database" sh -eu -c 'PGPASSWORD=$(cat /run/secrets/restore_db_password); export PGPASSWORD; pg_restore -U onelayer_restore -d onelayer_restored --clean --if-exists --no-owner'
docker exec "$database" sh -eu -c 'PGPASSWORD=$(cat /run/secrets/restore_db_password); export PGPASSWORD; test "$(psql -U onelayer_restore -d onelayer_restored -Atc "select marker from onelayer_fixture_marker")" = ONELAYER_SYNTHETIC_FIXTURE_V1'
docker exec "$container" sh -eu -c 'truncate -s 0 /work/source.dump /run/onelayer-recovery/share-1 /run/onelayer-recovery/share-3 /run/onelayer-recovery/share-5; rm /work/source.dump /run/onelayer-recovery/share-1 /run/onelayer-recovery/share-3 /run/onelayer-recovery/share-5'
secret_root=/dev/shm/onelayer-recovery-lab-secrets
for index in 1 2 3 4 5; do
  share="$secret_root/recovery-share-$index"
  if [[ -f "$share" ]]; then truncate -s 0 "$share"; rm "$share"; fi
done
docker compose -p "$project" -f "$lab_dir/compose.yaml" rm -sf key-holder-1 key-holder-2 key-holder-3 key-holder-4 key-holder-5 clean-room-restore
echo "clean-room restore completed from custodian replica"
