#!/usr/bin/env bash
set -euo pipefail

project=onelayer-recovery-lab
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "$script_dir/../../.." && pwd)
secret_root=/dev/shm/onelayer-recovery-lab-secrets

if git -C "$repo_root" ls-files | awk -F/ '$NF == ".env" || $NF ~ /^(recovery-kek|recovery-share-[1-5])$/ { found=1 } END { exit found ? 0 : 1 }'; then
  echo "key material filename is tracked by Git" >&2
  exit 70
fi
log_file=$(mktemp /tmp/onelayer-recovery-lab-logs.XXXXXX)
trap 'rm -f "$log_file"' EXIT
for service in source-db custodian-a custodian-b custodian-c clean-room-db; do
  container="${project}-${service}-1"
  if docker inspect "$container" >/dev/null 2>&1; then
    "$script_dir/fixture-guard" container "$container"
    docker logs "$container" >> "$log_file" 2>&1
  fi
done
for secret in "$secret_root"/*; do
  if [[ -s "$secret" ]] && rg --fixed-strings --quiet --file "$secret" "$log_file"; then
    echo "key material appeared in fixture logs" >&2
    exit 71
  fi
done
echo "recovery lab artifacts contain no tracked or logged key material"
