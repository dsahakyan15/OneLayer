#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "$script_dir/../../.." && pwd)
runtime=/dev/shm/onelayer-devnet-demo
rpc=${ONELAYER_RPC_URL:-https://api.devnet.solana.com}
ws=${ONELAYER_WEBSOCKET_URL:-wss://api.devnet.solana.com}
[[ "$rpc" == https://api.devnet.solana.com ]] || { echo "RPC must be canonical devnet" >&2; exit 30; }
[[ "$ws" == wss://api.devnet.solana.com ]] || { echo "WebSocket must be canonical devnet" >&2; exit 31; }
for command in git docker node cargo solana solana-keygen anchor curl sha256sum; do
  command -v "$command" >/dev/null || { echo "$command is required" >&2; exit 32; }
done
docker compose version >/dev/null
docker info >/dev/null 2>&1 || { echo "Docker daemon is not accessible" >&2; exit 40; }
[[ $(node --version) == v24.* ]] || { echo "Node.js 24 is required" >&2; exit 33; }
[[ $(solana --version) == solana-cli\ 3.1.10* ]] || { echo "Solana CLI 3.1.10 is required" >&2; exit 34; }
[[ $(anchor --version) == anchor-cli\ 1.1.2 ]] || { echo "Anchor CLI 1.1.2 is required" >&2; exit 35; }
[[ -s "$runtime/test-payer.json" ]] || { echo "initialize-runtime must run first" >&2; exit 36; }
for secret_file in issuer-secret admin-credentials.json; do
  [[ -s "$runtime/$secret_file" ]] || { echo "$secret_file is missing; run initialize-runtime" >&2; exit 42; }
done
[[ $(stat -c %a "$runtime/test-payer.json") == 600 ]] || { echo "test payer permissions must be 0600" >&2; exit 37; }
[[ $(NO_DNA=1 solana-keygen pubkey "$runtime/onelayer_registry-keypair.json") == 6A2LSwaJKdwVAEggAfHjZVAKb2ATWM7AXBrgDEqczEo ]] || { echo "program test key does not match declare_id" >&2; exit 38; }
tracked_credential=$(git -C "$repo_root" ls-files | awk '/(^|\/)(id\.json|.*keypair\.json|\.env)$/ { print; exit }')
if [[ -n "$tracked_credential" ]]; then
  echo "tracked credential-like file detected" >&2
  exit 39
fi
docker compose -p onelayer-devnet-demo -f "$repo_root/deploy/devnet-demo/compose.yaml" config --quiet

# Rent for one ledger segment is 0.0708 SOL; the margin covers fees and a second
# segment. Failing here is cheaper than failing mid-demo.
required_lamports=200000000
payer=$(NO_DNA=1 solana-keygen pubkey "$runtime/test-payer.json")
balance=$(NO_DNA=1 solana balance --url "$rpc" --lamports "$payer" 2>/dev/null | awk '{print $1}')
[[ "$balance" =~ ^[0-9]+$ ]] || { echo "unable to read devnet balance for $payer" >&2; exit 43; }
if (( balance < required_lamports )); then
  echo "test payer $payer holds $balance lamports; at least $required_lamports are required" >&2
  echo "remediation: solana airdrop 2 $payer --url $rpc" >&2
  exit 44
fi

# Ports must be free or already owned by this Compose project.
project_ports=$(docker compose -p onelayer-devnet-demo -f "$repo_root/deploy/devnet-demo/compose.yaml" ps --format '{{.Publishers}}' 2>/dev/null || true)
for port in 8080 8090 8091 55432; do
  if (exec 3<>/dev/tcp/127.0.0.1/"$port") 2>/dev/null; then
    exec 3>&- 3<&- || true
    case "$project_ports" in
      *":$port"*) ;;
      *) echo "port 127.0.0.1:$port is taken by another process" >&2; exit 45 ;;
    esac
  fi
done

# `rg` is optional; the portable fallback keeps preflight working on a clean host.
search() {
  if command -v rg >/dev/null; then rg --no-messages --files-with-matches "$1" "$2"; else grep -rls "$1" "$2"; fi
}
if [[ -n "$(search 'BEGIN [A-Z ]*PRIVATE KEY' "$repo_root/deploy" || true)" ]]; then
  echo "private key material found under deploy/" >&2
  exit 46
fi

echo "preflight ok: synthetic fixture, loopback ports, funded devnet test payer"
