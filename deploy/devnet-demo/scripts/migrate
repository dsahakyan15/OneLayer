#!/usr/bin/env sh
set -eu

export PGPASSWORD="$(cat "$PGPASSWORD_FILE")"
psql -v ON_ERROR_STOP=1 <<'SQL'
CREATE TABLE IF NOT EXISTS schema_migration (
  version TEXT PRIMARY KEY,
  sha256 TEXT NOT NULL,
  applied_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
SQL

for migration in /migrations/*.sql; do
  version=$(basename "$migration")
  if [ "$(psql -Atc "SELECT count(*) FROM schema_migration WHERE version = '$version'")" = 0 ]; then
    digest=$(sha256sum "$migration" | cut -d' ' -f1)
    psql -v ON_ERROR_STOP=1 -1 -f "$migration"
    psql -v ON_ERROR_STOP=1 -c "INSERT INTO schema_migration(version, sha256) VALUES ('$version', '$digest')"
  fi
done

psql -v ON_ERROR_STOP=1 -1 -f /fixtures/devnet-demo.sql
test "$(psql -Atc "SELECT marker FROM demo_fixture_marker")" = ONELAYER_SYNTHETIC_DEVNET_DEMO_V1
