#!/usr/bin/env bash
set -euo pipefail

project=onelayer-devnet-demo
kind=${1:?resource kind required}
name=${2:?resource name required}
case "$kind" in
  container)
    project_label=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project" }}' "$name")
    fixture_label=$(docker inspect --format '{{ index .Config.Labels "com.onelayer.fixture" }}' "$name")
    environment_label=$(docker inspect --format '{{ index .Config.Labels "com.onelayer.environment" }}' "$name")
    ;;
  volume)
    project_label=$(docker volume inspect --format '{{ index .Labels "com.docker.compose.project" }}' "$name")
    fixture_label=$(docker volume inspect --format '{{ index .Labels "com.onelayer.fixture" }}' "$name")
    environment_label=$(docker volume inspect --format '{{ index .Labels "com.onelayer.environment" }}' "$name")
    ;;
  *) echo "unsupported guarded resource kind" >&2; exit 20 ;;
esac
if [[ "$project_label" != "$project" || "$fixture_label" != true || "$environment_label" != synthetic-devnet-demo ]]; then
  echo "resource is outside the isolated synthetic devnet demo" >&2
  exit 21
fi
