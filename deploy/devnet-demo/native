start_stack() {
  ensure_private_state
  ensure_runtime
  ensure_node_dependencies
  provision_publication_keys
  ensure_trust_policy
  ensure_ports
  ensure_postgres
  migrate_database
  start_audit
  build_web

  start_demo_api
  start_monitor

  start_verifier

  start_process mvp-web env \
    PORT=8091 \
    HOSTNAME=127.0.0.1 \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    ONELAYER_ADMIN_API_URL=http://127.0.0.1:8090 \
    ONELAYER_VERIFIER_URL=http://127.0.0.1:8080 \
    npm --prefix "$repo_root/apps/mvp-web" start
  wait_for_http http://127.0.0.1:8091/verify mvp-web

  echo "Native MVP is running"
  echo "Admin panel:  http://127.0.0.1:8091/admin"
  echo "OneLayer panel: http://127.0.0.1:8091/verify"
  echo "Demo credentials: $runtime/admin-credentials.json"
  echo "Logs: $logs_dir"
}

stop_stack() {
  stop_process monitor
  stop_process mvp-web
  stop_process verifier
  stop_process demo-api
  stop_process audit
  if postgres_running; then
    "$pg_ctl" -D "$postgres_data" stop -m fast >/dev/null
  fi
}

status_stack() {
  printf 'postgres: '
  if postgres_running; then echo running; else echo stopped; fi
  for service in demo-api verifier mvp-web audit monitor; do
    printf '%s: ' "$service"
    if service_pid "$service" >/dev/null 2>&1; then echo running; else echo stopped; fi
  done
  for endpoint in http://127.0.0.1:8090/v1/health http://127.0.0.1:8080/v1/health http://127.0.0.1:8091/verify; do
    code=$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 2 "$endpoint" || true)
    printf '%s %s\n' "$code" "$endpoint"
  done
}

case "$command" in
  monitor-start)
    ensure_private_state
    [[ "$audit_enabled" == 1 ]] || die "monitor-start requires the explicit local lab profile"
    postgres_running || die "namespace PostgreSQL is not running"
    start_monitor
    ;;
  verifier-restart)
    ensure_private_state
    ensure_trust_policy
    stop_process verifier
    start_verifier
    ;;
  api-restart)
    ensure_private_state
    postgres_running || die "namespace PostgreSQL is not running"
    start_audit
    stop_process demo-api
    migrate_database
    start_demo_api
    ;;
  audit-start)
    ensure_private_state
    [[ "$audit_enabled" == 1 ]] || die "audit-start requires the explicit local lab profile"
    if port_in_use 18991 && ! service_pid audit >/dev/null 2>&1; then die "audit port is already in use"; fi
    [[ -s "$database_url_file" ]] || die "start the namespace database first"
    start_audit
    ;;
  start)
    start_stack
    ;;
  stop|down)
    stop_stack
    ;;
  restart)
    stop_stack
    start_stack
    ;;
  build)
    build_web
    ;;
  migrate)
    ensure_private_state
    ensure_runtime
    ensure_postgres
    migrate_database
    ;;
  rotate-trust)
    ensure_private_state
    ensure_runtime
    rotate_trust
    ;;
  reset-trust)
    ensure_private_state
    ensure_runtime
    reset_trust
    ;;
  status)
    status_stack
    ;;
  logs)
    tail -f "$logs_dir/demo-api.log" "$logs_dir/verifier.log" "$logs_dir/mvp-web.log"
    ;;
  *)
    cat >&2 <<'EOF'
usage: deploy/devnet-demo/native [start|stop|restart|build|migrate|rotate-trust|reset-trust|status|logs]

  start         start the local demo stack
  stop|down     stop the stack
  restart       stop then start
  build         build the web app
  migrate       apply database migrations and fixtures
  rotate-trust  deliberate, floor-preserving rotation of an expired demo trust
                policy (refuses without an intact anti-rollback watermark)
  reset-trust   DELIBERATE anti-rollback reset (discards the accepted floor)
  status        report service status
  logs          tail service logs

The legacy gov.registry.land namespace is the default and is never switched
implicitly. Set ONELAYER_REGISTRY_ID for an isolated ADR-0010 namespace (which
gets its own database, trust policy and anti-rollback watermark).
EOF
    exit 2
    ;;
esac
