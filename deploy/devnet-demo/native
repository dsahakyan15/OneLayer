#!/usr/bin/env bash
set -euo pipefail
umask 077

command=${1:-start}
demo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "$demo_dir/../.." && pwd)
scripts="$demo_dir/scripts"
# Preserve the legacy state, isolate every explicit synthetic namespace by a
# collision-resistant token (punctuation folding would alias a.b and a_b).
registry_namespace="${ONELAYER_REGISTRY_ID:-gov.registry.land}"
namespace_token=$(printf '%s' "$registry_namespace" | sha256sum | cut -c1-24)
native_base="${ONELAYER_NATIVE_STATE_DIR:-$demo_dir/.runtime/native}"
native_root="$native_base"
if [[ "$registry_namespace" != "gov.registry.land" ]]; then
  native_root="$native_base/namespaces/$namespace_token"
fi
postgres_data="$native_root/postgres"
logs_dir="$native_root/logs"
pids_dir="$native_root/pids"
pg_port=${ONELAYER_NATIVE_PG_PORT:-55432}
pg_user=onelayer_demo
if [[ "$registry_namespace" == "gov.registry.land" ]]; then
  database=onelayer_demo
  policy_file="$native_root/verifier-trust-policy.json"
  verifier_trust_state="${XDG_STATE_HOME:-$HOME/.local/state}/onelayer-devnet-demo/verifier-trust/accepted.json"
  runtime="${ONELAYER_DEMO_RUNTIME_DIR:-/dev/shm/onelayer-devnet-demo}"
  publication_key_root="${XDG_STATE_HOME:-$HOME/.local/state}/onelayer-devnet-demo/keys"
else
  database="onelayer_demo_$namespace_token"
  policy_file="$native_root/trust-policy/policy.json"
  verifier_trust_state="$native_root/verifier-trust/accepted.json"
  runtime="${ONELAYER_DEMO_RUNTIME_DIR:-$native_root/runtime}"
  publication_key_root="${XDG_STATE_HOME:-$HOME/.local/state}/onelayer-devnet-demo/keys/namespaces/$namespace_token"
fi
database_url_file="$native_root/database-url"
# Restart-stable SOFTWARE DEMO publication HMAC keys (M3). Never printed. The
# operator signer key lives in the hardened persistent key store.
publication_keys_file="$native_root/publication-keys.json"
publication_operator_key_id="demo-operator-1"
publication_signer_file="$publication_key_root/demo-operator.json"
# Distinct hardened approval-issuer key (H5). This MUST be a different key file
# from the operator/chain signer: the runtime requires an independently
# authenticated approval receipt whose issuer is not the signer. If it is missing
# or aliases the signer key, startup fails closed (PUBLICATION_CONFIG_INCOMPLETE /
# PUBLICATION_APPROVAL_KEY_REUSED). Never printed.
publication_approval_file="$publication_key_root/approval-issuer.json"
# Explicit cluster + (for local/unknown clusters) the live expected genesis hash.
# `solana:devnet` is pinned in the deployment; a local/unknown chain must set
# ONELAYER_RPC_GENESIS_HASH to the validator's actual getGenesisHash, else the
# chain-identity check refuses to reserve or sign anything.
publication_cluster="${ONELAYER_PUBLICATION_CLUSTER:-solana:devnet}"
publication_rpc_genesis="${ONELAYER_RPC_GENESIS_HASH:-}"
# RPC endpoint. Defaults to devnet; a local-validator profile points this at the
# local validator AND sets ONELAYER_RPC_GENESIS_HASH to its actual getGenesisHash.
publication_rpc_url="${ONELAYER_RPC_URL:-https://api.devnet.solana.com}"
audit_root="$native_root/audit"
audit_enabled=0
if [[ "${ONELAYER_ADMIN_ACCESS_LAB:-0}" == 1 && "${ONELAYER_SYNTHETIC_PROFILE:-}" == local-validator && "$publication_cluster" == solana:local && "$registry_namespace" != gov.registry.land ]]; then
  audit_enabled=1
fi
audit_target="${CARGO_TARGET_DIR:-}"
if [[ -z "$audit_target" && -n "${ONELAYER_SBF_CACHE_DIR:-}" ]]; then
  audit_target="$(dirname -- "$ONELAYER_SBF_CACHE_DIR")/cargo-target"
fi
audit_target="${audit_target:-$native_base/build}"
audit_binary="$audit_target/debug/onelayer-audit"
monitor_root="$native_root/monitor"
monitor_binary="$audit_target/debug/onelayer-monitor"
audit_environment=()

die() {
  echo "native demo: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

[[ "$native_root" = /* ]] || die "ONELAYER_NATIVE_STATE_DIR must be an absolute path"

require_command node
require_command npm
require_command curl
require_command sha256sum

pg_bin_dir=""
if command -v brew >/dev/null 2>&1; then
  brew_prefix=$(brew --prefix postgresql@17 2>/dev/null || true)
  if [[ -x "$brew_prefix/bin/pg_ctl" ]]; then
    pg_bin_dir="$brew_prefix/bin"
  fi
fi
if [[ -z "$pg_bin_dir" ]] && command -v pg_ctl >/dev/null 2>&1; then
  pg_bin_dir=$(dirname "$(command -v pg_ctl)")
fi
[[ -x "$pg_bin_dir/pg_ctl" ]] || die "PostgreSQL 17 is required; install it with: brew install postgresql@17"

pg_ctl="$pg_bin_dir/pg_ctl"
initdb="$pg_bin_dir/initdb"
psql="$pg_bin_dir/psql"
createdb="$pg_bin_dir/createdb"
pg_isready="$pg_bin_dir/pg_isready"

mkdir -p "$logs_dir" "$pids_dir" "$(dirname "$policy_file")"

psql_db() {
  local db=$1
  shift
  "$psql" -X -h 127.0.0.1 -p "$pg_port" -U "$pg_user" -d "$db" "$@"
}

postgres_running() {
  "$pg_ctl" -D "$postgres_data" status >/dev/null 2>&1
}

process_start_time() {
  local pid=$1 details
  [[ "$pid" =~ ^[1-9][0-9]*$ && -r "/proc/$pid/stat" ]] || return 1
  details=$(<"/proc/$pid/stat")
  details="${details##*) }"
  [[ "${details%% *}" != Z ]] || return 1
  awk '{print $20}' <<< "$details"
}

service_pid() {
  local name=$1 pid actual expected
  [[ -s "$pids_dir/$name.pid" && -s "$pids_dir/$name.pid.start" ]] || return 1
  pid=$(<"$pids_dir/$name.pid")
  expected=$(<"$pids_dir/$name.pid.start")
  actual=$(process_start_time "$pid") || return 1
  [[ "$actual" == "$expected" ]] || return 1
  printf '%s\n' "$pid"
}

port_in_use() {
  local port=$1
  (exec 3<>/dev/tcp/127.0.0.1/"$port") 2>/dev/null
}

ensure_private_state() {
  node - "$native_root" "$postgres_data" <<'NODE'
const fs = require('node:fs');
for (const [index, path] of process.argv.slice(2).entries()) {
  let info;
  try { info = fs.lstatSync(path); }
  catch (error) { if (error.code === 'ENOENT' && index === 1) continue; throw error; }
  if (!info.isDirectory() || info.uid !== process.getuid() || (info.mode & 0o077) !== 0) {
    console.error('native demo: private Unix runtime directories are required; set ONELAYER_NATIVE_STATE_DIR outside the shared checkout and preserve the existing database');
    process.exit(1);
  }
}
NODE
}

ensure_runtime() {
  ONELAYER_DEMO_RUNTIME_DIR="$runtime" "$scripts/initialize-runtime" >/dev/null
  mkdir -p "$native_root"
  printf 'postgresql://%s@127.0.0.1:%s/%s\n' "$pg_user" "$pg_port" "$database" > "$database_url_file"
  chmod 600 "$database_url_file"
}

ensure_node_dependencies() {
  [[ -d "$repo_root/apps/demo-api/node_modules/pg" ]] || die "demo-api dependencies are missing; run npm --prefix apps/demo-api ci"
  [[ -d "$repo_root/apps/verifier/node_modules/@solana/kit" ]] || die "verifier dependencies are missing; run npm --prefix apps/verifier ci"
  [[ -d "$repo_root/apps/mvp-web/node_modules/next" ]] || die "mvp-web dependencies are missing; run npm --prefix apps/mvp-web ci"
  [[ -d "$repo_root/packages/onchain-client/node_modules/@solana/kit" ]] || die "shared on-chain dependencies are missing; run npm --prefix packages/onchain-client ci"
}

ensure_postgres() {
  if [[ ! -f "$postgres_data/PG_VERSION" ]]; then
    mkdir -p "$postgres_data"
    "$initdb" -D "$postgres_data" -U "$pg_user" --auth=trust --encoding=UTF8 --locale=C >/dev/null
  fi
  if ! postgres_running; then
    "$pg_ctl" -D "$postgres_data" -l "$logs_dir/postgres.log" \
      -o "-p $pg_port -h 127.0.0.1 -k ''" start >/dev/null
  fi
  for _ in $(seq 1 60); do
    if "$pg_isready" -h 127.0.0.1 -p "$pg_port" -U "$pg_user" -d postgres >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done
  "$pg_isready" -h 127.0.0.1 -p "$pg_port" -U "$pg_user" -d postgres >/dev/null \
    || die "PostgreSQL did not become ready; see $logs_dir/postgres.log"

  if [[ "$(psql_db postgres -Atqc "SELECT count(*) FROM pg_database WHERE datname='$database'")" != 1 ]]; then
    "$createdb" -h 127.0.0.1 -p "$pg_port" -U "$pg_user" "$database"
  fi
}

# A migration that changed after it was applied must fail startup instead of
# being skipped. A recorded row without a digest fails closed too: the applied
# bytes are unknown, and the runner must not record the current file as if
# those bytes had been verified.
verify_migration_digests() {
  local rows version digest file current
  rows=$(psql_db "$database" -At -F '|' -c \
    "SELECT version, coalesce(sha256, '') FROM schema_migration ORDER BY version")
  while IFS='|' read -r version digest; do
    [[ -n "$version" ]] || continue
    file="$repo_root/db/migrations/$version"
    [[ -f "$file" ]] || die "migration $version is recorded as applied but has no file in db/migrations; refusing to start"
    current=$(sha256sum "$file" | cut -d' ' -f1)
    [[ -n "$digest" ]] \
      || die "migration $version has no recorded digest, so its applied bytes cannot be verified; refusing to start. Restore the file it was applied from, or recreate the demo database: recording the current file would claim a verification that never happened"
    [[ "$digest" == "$current" ]] \
      || die "migration $version was applied with digest $digest but the file now hashes to $current; restore the applied file or add a new migration instead of editing an applied one"
  done <<< "$rows"
}

migrate_database() {
  if service_pid demo-api >/dev/null 2>&1; then
    die "stop demo-api before migrations; use native restart for a running stack"
  fi
  psql_db "$database" -v ON_ERROR_STOP=1 <<'SQL'
CREATE TABLE IF NOT EXISTS schema_migration (
  version TEXT PRIMARY KEY,
  sha256 TEXT NOT NULL,
  applied_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
ALTER TABLE schema_migration ADD COLUMN IF NOT EXISTS sha256 TEXT;
SQL

  # Verification runs before any pending migration or fixture is applied.
  verify_migration_digests

  # psql substitutes -v variables only while reading a file or stdin, never in
  # -c, so the checksum row is recorded from a generated statement file. That
  # file and the migration snapshots live in a private temp directory owned by
  # this run, so concurrent runners cannot clobber each other's statements,
  # and the digest always covers the exact bytes that are applied.
  work_dir=$(mktemp -d "${TMPDIR:-/tmp}/onelayer-native-migrations.XXXXXX")
  trap 'rm -rf -- "$work_dir"' EXIT
  cat > "$work_dir/record.sql" <<'SQL'
DO $$ BEGIN PERFORM pg_advisory_xact_lock(7710061); END $$;
INSERT INTO schema_migration(version, sha256) VALUES (:'version', :'digest');
SQL

  for migration in "$repo_root"/db/migrations/*.sql; do
    version=$(basename "$migration")
    applied=$(psql_db "$database" -At -v version="$version" <<'SQL'
SELECT count(*) FROM schema_migration WHERE version = :'version';
SQL
)
    if [[ "$applied" == 0 ]]; then
      snapshot="$work_dir/$version"
      cp -- "$migration" "$snapshot"
      digest=$(sha256sum "$snapshot" | cut -d' ' -f1)
      # One transaction applies the snapshot and records its digest, so the
      # journal covers the applied bytes and never exists without them. The advisory lock
      # serializes concurrent runners; the primary key on version then turns a
      # lost race into a loud failure instead of applying the file twice.
      psql_db "$database" -v ON_ERROR_STOP=1 -1 \
        -v version="$version" -v digest="$digest" \
        -f "$work_dir/record.sql" -f "$snapshot"
    fi
  done

  if [[ "$registry_namespace" == "gov.registry.land" ]]; then
    # Legacy namespace: full fixture (marker + legacy synthetic records),
    # preserved exactly for the default gov.registry.land deployment.
    psql_db "$database" -v ON_ERROR_STOP=1 -1 -f "$repo_root/db/fixtures/devnet-demo.sql"
  else
    # Isolated ADR-0010 namespace: synthetic marker ONLY. The legacy fixture
    # records (SYNTHETIC-1/2) are never loaded into an isolated namespace; its
    # record space starts empty and is populated only through the application.
    psql_db "$database" -v ON_ERROR_STOP=1 <<'SQL'
INSERT INTO demo_fixture_marker(marker) VALUES ('ONELAYER_SYNTHETIC_DEVNET_DEMO_V1')
ON CONFLICT (marker) DO NOTHING;
SQL
  fi
  marker=$(psql_db "$database" -Atqc "SELECT marker FROM demo_fixture_marker")
  [[ "$marker" == ONELAYER_SYNTHETIC_DEVNET_DEMO_V1 ]] || die "native database fixture marker is missing"
}

ensure_ports() {
  local port
  local ports=(8080 8090 8091)
  if [[ "$audit_enabled" == 1 ]]; then ports+=(18991); fi
  for port in "${ports[@]}"; do
    if port_in_use "$port"; then
      case "$port" in
        8080) service=verifier ;;
        8090) service=demo-api ;;
        8091) service=mvp-web ;;
        18991) service=audit ;;
      esac
      service_pid "$service" >/dev/null 2>&1 || die "127.0.0.1:$port is already in use; stop the other MVP services first"
    fi
  done
}

start_process() {
  local name=$1
  shift
  if service_pid "$name" >/dev/null 2>&1; then
    return
  fi
  rm -f "$pids_dir/$name.pid"
  nohup setsid "$@" > "$logs_dir/$name.log" 2>&1 < /dev/null &
  local child=$!
  echo "$child" > "$pids_dir/$name.pid"
  process_start_time "$child" > "$pids_dir/$name.pid.start"
}

stop_process() {
  local name=$1
  local pid
  pid=$(service_pid "$name" 2>/dev/null || true)
  [[ -n "$pid" ]] || { rm -f "$pids_dir/$name.pid" "$pids_dir/$name.pid.start"; return; }
  kill -- "-$pid" >/dev/null 2>&1 || kill "$pid" >/dev/null 2>&1 || true
  for _ in $(seq 1 20); do
    kill -0 "$pid" >/dev/null 2>&1 || break
    sleep 0.25
  done
  rm -f "$pids_dir/$name.pid" "$pids_dir/$name.pid.start"
}

wait_for_http() {
  local url=$1
  for _ in $(seq 1 60); do
    service_pid "$2" >/dev/null || {
      echo "service $2 exited before readiness; see $logs_dir/$2.log" >&2
      return 1
    }
    if curl --silent --fail --max-time 2 "$url" >/dev/null 2>&1; then
      return
    fi
    sleep 1
  done
  echo "timed out waiting for $url" >&2
  tail -80 "$logs_dir/${2:-demo-api}.log" >&2 2>/dev/null || true
  exit 50
}

build_web() {
  npm --prefix "$repo_root/apps/mvp-web" run build
}

# Record which registry namespace this stack is actually serving. A reuse of a
# running stack must verify this identity: a request for an isolated namespace
# must never silently bind to a legacy-namespace stack (ADR-0010).
record_stack_identity() {
  node - "$pids_dir/stack-identity.json" "${ONELAYER_REGISTRY_ID:-gov.registry.land}" "${ONELAYER_SYNTHETIC_PROFILE:-}" <<'NODE'
const fs = require('node:fs');
const [file, registryId, syntheticProfile] = process.argv.slice(2);
const identity = {
  schema: "onelayer.stack-identity.v1",
  registryId,
  syntheticProfile: syntheticProfile === "1" || syntheticProfile === "true",
  recordedAt: new Date().toISOString(),
};
fs.writeFileSync(file, `${JSON.stringify(identity)}\n`, { mode: 0o600 });
NODE
}

# Restart-stable SOFTWARE DEMO publication keys (M3): HMAC id/field keys plus a
# persistent operator signer key in the hardened key store. This is LOCAL key
# initialization only — it never signs or sends a chain transaction, and no
# secret is ever printed. Provisioned once and reused across restarts.
provision_publication_keys() {
  node --experimental-transform-types --input-type=module - "$repo_root" "$publication_signer_file" "$publication_approval_file" "$publication_keys_file" <<'NODE'
import { pathToFileURL } from 'node:url';
import { constants } from 'node:fs';
import { open } from 'node:fs/promises';
import { randomBytes } from 'node:crypto';
const [repo, signer, approval, hmac] = process.argv.slice(2);
const { ensureKeyPair } = await import(pathToFileURL(repo + '/apps/demo-api/scripts/live-demo-key-store.ts').href);
if (signer === approval) throw new Error('PUBLICATION_APPROVAL_KEY_REUSED');
await ensureKeyPair({keyFile:signer});
await ensureKeyPair({keyFile:approval});
try {
  const file = await open(hmac, constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | constants.O_NOFOLLOW, 0o600);
  try {
    await file.writeFile(JSON.stringify({idKey:randomBytes(32).toString('hex'),fieldKeyMaster:randomBytes(32).toString('hex')}) + '\n');
    await file.sync();
  } finally { await file.close(); }
} catch (error) { if (error.code !== 'EEXIST') throw error; }
const file = await open(hmac, constants.O_RDONLY | constants.O_NOFOLLOW);
try {
  const info = await file.stat();
  if (!info.isFile() || info.uid !== process.getuid() || (info.mode & 0o077) || info.size > 4096) throw new Error('PUBLICATION_KEYS_FILE_UNSAFE');
} finally { await file.close(); }
NODE
}

# Provision / validate the verifier trust policy with the FAILURE MODE KEPT
# DISTINCT (M4). create-demo-trust-policy.ts never overwrites, rotates or resets
# existing trust; it reports one of:
#   0 provisioned or retained   10 expired   11 watermark missing   12 mismatch
# Only a clean expiry (10) with an INTACT anti-rollback watermark is eligible
# for a floor-preserving rotation. A missing watermark is NEVER bootstrapped
# implicitly and a mismatch/corruption is NEVER silently retired or reset: both
# fail closed with an actionable code. The prior catch-all that moved the policy
# aside on ANY error (silently resetting the accepted floor) is gone.
ensure_trust_policy() {
  local output rc=0
  output=$(node --experimental-transform-types "$repo_root/apps/verifier/scripts/create-demo-trust-policy.ts" \
      "$runtime/issuer-secret" "$policy_file" "$verifier_trust_state" 2>&1) || rc=$?
  case "$rc" in
    0)
      [[ -n "$output" ]] && printf '%s\n' "$output"
      return 0 ;;
    10)
      if [[ ! -f "$verifier_trust_state" ]]; then
        echo "native demo: trust policy is EXPIRED but the anti-rollback watermark is missing." >&2
        echo "native demo: refusing to rotate — rotation without the watermark would reset the accepted floor." >&2
        echo "native demo: restore the watermark from backup, or run './deploy/devnet-demo/native reset-trust' as a deliberate anti-rollback reset." >&2
        return 1
      fi
      echo "native demo: expired trust policy; startup refuses automatic rotation." >&2
      echo "native demo: review and run native rotate-trust explicitly; the accepted floor is preserved." >&2
      return 1 ;;
    11)
      echo "native demo: verifier anti-rollback watermark is MISSING: $verifier_trust_state" >&2
      [[ -n "$output" ]] && echo "native demo: $output" >&2
      echo "native demo: refusing to start (no implicit trust bootstrap)." >&2
      echo "native demo: restore the watermark from backup, or run './deploy/devnet-demo/native reset-trust' as a deliberate anti-rollback reset." >&2
      return 1 ;;
    12)
      echo "native demo: verifier trust policy does not authorize this deployment; refusing to auto-retire or reset." >&2
      [[ -n "$output" ]] && echo "native demo: $output" >&2
      echo "native demo: review the policy; run './deploy/devnet-demo/native rotate-trust' deliberately if a rotation is intended." >&2
      return 1 ;;
    *)
      echo "native demo: verifier trust policy provisioning failed (exit $rc); refusing to start." >&2
      [[ -n "$output" ]] && echo "native demo: $output" >&2
      return 1 ;;
  esac
}

# Deliberate, floor-preserving rotation of an expired demo trust policy. This is
# the ONLY rotation entry point; it refuses without an intact anti-rollback
# watermark so the accepted floor is never silently reset.
rotate_trust() {
  [[ -f "$policy_file" ]] || die "no trust policy to rotate at $policy_file"
  [[ -f "$verifier_trust_state" ]] \
    || die "anti-rollback watermark $verifier_trust_state is missing; refusing to rotate (would reset the accepted floor). Run './deploy/devnet-demo/native reset-trust' only as a deliberate anti-rollback reset."
  local retired="$policy_file.retired-$(date -u +%Y%m%dT%H%M%SZ)"
  mv "$policy_file" "$retired"
  echo "native demo: rotating demo trust policy (deliberate, floor-preserving); previous retired to $(basename "$retired")"
  if ! node --experimental-transform-types "$repo_root/apps/verifier/scripts/create-demo-trust-policy.ts" \
    "$runtime/issuer-secret" "$policy_file" "$verifier_trust_state"; then
    if [[ ! -e "$policy_file" ]]; then mv -- "$retired" "$policy_file"; fi
    die "trust rotation failed; prior policy retained when no replacement was created"
  fi
}

# Deliberate anti-rollback RESET: retire the policy and provision a FRESH
# watermark. This discards the accepted floor and is never done automatically —
# it requires this explicit operator command.
reset_trust() {
  echo "native demo: DELIBERATE anti-rollback reset — the accepted floor will be discarded." >&2
  if [[ -f "$policy_file" ]]; then
    local retired="$policy_file.retired-$(date -u +%Y%m%dT%H%M%SZ)"
    mv "$policy_file" "$retired"
    echo "native demo: previous policy retired to $(basename "$retired")"
  fi
  if [[ -f "$verifier_trust_state" ]]; then
    local state_retired="$verifier_trust_state.retired-$(date -u +%Y%m%dT%H%M%SZ)"
    mv "$verifier_trust_state" "$state_retired"
    echo "native demo: previous watermark retired to $(basename "$state_retired")"
  fi
  node --experimental-transform-types "$repo_root/apps/verifier/scripts/create-demo-trust-policy.ts" \
    "$runtime/issuer-secret" "$policy_file" "$verifier_trust_state"
  echo "native demo: fresh trust watermark bootstrapped (revision restarts). This was a deliberate operator reset."
}

start_audit() {
  [[ "$audit_enabled" == 1 ]] || return 0
  require_command cargo
  require_command python3
  (cd "$repo_root" && CARGO_TARGET_DIR="$audit_target" cargo build --locked -p onelayer-audit) > "$logs_dir/audit-build.log" 2>&1 \
    || die "audit build failed; see $logs_dir/audit-build.log"
  python3 "$scripts/initialize-audit.py" "$audit_root" "$audit_binary" "$database_url_file" "$registry_namespace" \
    || die "private audit provisioning failed"
  start_process audit "$audit_binary" serve --config "$audit_root/audit.json"
  local ready=0
  for _ in $(seq 1 30); do
    service_pid audit >/dev/null || die "audit exited; see $logs_dir/audit.log"
    if python3 "$scripts/initialize-audit.py" check "$audit_root" 2>/dev/null; then ready=1; break; fi
    sleep 1
  done
  [[ "$ready" == 1 ]] || die "audit did not become ready"
  audit_environment=(
    ONELAYER_AUDIT_URL=http://127.0.0.1:18991
    ONELAYER_AUDIT_APPEND_CAP_FILE="$audit_root/append.cap"
    ONELAYER_AUDIT_READ_CAP_FILE="$audit_root/read.cap"
    ONELAYER_AUDIT_EXPORT_CAP_FILE="$audit_root/export.cap"
    ONELAYER_AUDIT_REBUILD_CAP_FILE="$audit_root/rebuild.cap"
    ONELAYER_AUDIT_STATUS_CAP_FILE="$audit_root/status.cap"
  )
}

start_monitor() {
  [[ "$audit_enabled" == 1 ]] || return 0
  require_command cargo
  require_command python3
  (cd "$repo_root" && CARGO_TARGET_DIR="$audit_target" cargo build --locked -p onelayer-monitor) > "$logs_dir/monitor-build.log" 2>&1 \
    || die "monitor build failed; see $logs_dir/monitor-build.log"
  psql_db "$database" -v ON_ERROR_STOP=1 -1 -f "$repo_root/apps/monitor/sql/monitor_readonly_role.sql" > "$logs_dir/monitor-role.log" 2>&1 \
    || die "monitor read-only role provisioning failed"
  python3 "$scripts/initialize-monitor.py" "$monitor_root" "$database_url_file" "$publication_keys_file" "$registry_namespace" "$publication_rpc_genesis" \
    || die "private monitor provisioning failed"
  if ! service_pid monitor >/dev/null 2>&1; then
    local result=0
    "$monitor_binary" once --config "$monitor_root/monitor.json" > "$logs_dir/monitor-preflight.log" 2>&1 || result=$?
    [[ "$result" == 0 || "$result" == 3 ]] || die "monitor refused startup; see $logs_dir/monitor-preflight.log"
    start_process monitor "$monitor_binary" run --config "$monitor_root/monitor.json"
  fi
  service_pid monitor >/dev/null || die "monitor exited; see $logs_dir/monitor.log"
}

