# Admin + public OneLayer panels. The build has no network access to the demo
# services; both are reached at runtime through the server-side proxy only.
FROM node:24.10.0-bookworm-slim AS build
WORKDIR /opt/onelayer/apps/mvp-web
COPY apps/mvp-web/package.json apps/mvp-web/package-lock.json ./
RUN npm ci
COPY apps/mvp-web/app ./app
COPY apps/mvp-web/components ./components
COPY apps/mvp-web/lib ./lib
COPY apps/mvp-web/next.config.ts apps/mvp-web/tsconfig.json ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:24.10.0-bookworm-slim
WORKDIR /opt/onelayer
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8091 HOSTNAME=0.0.0.0
COPY --from=build /opt/onelayer/apps/mvp-web/.next/standalone ./
COPY --from=build /opt/onelayer/apps/mvp-web/.next/static ./apps/mvp-web/.next/static
USER node
ENTRYPOINT ["node", "apps/mvp-web/server.js"]
